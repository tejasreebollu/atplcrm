apiVersion: v1
kind: Pod
metadata:
  name: postgres-restore
  namespace: atplcrm
spec:
  containers:
    - name: postgres
      image: postgres:17-alpine
      env:
        - name: POSTGRES_DB
          value: atplcrm
        - name: POSTGRES_USER
          value: atplcrm
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef:
              name: atplcrm-secrets
              key: POSTGRES_PASSWORD
      ports:
        - containerPort: 5432
      volumeMounts:
        - name: postgres-data
          mountPath: /var/lib/postgresql/data
  volumes:
    - name: postgres-data
      persistentVolumeClaim:
        claimName: postgres-pvc
